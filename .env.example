# Model provider: ollama (local default) | lmstudio | dashscope
MODEL_PROVIDER=ollama

# Studio model picker: only show custom local gateways (Ollama / LM Studio)
# Set false/omit to also show Mastra's built-in cloud providers.
AUTO_BLOCK_EXTERNAL_PROVIDERS=true

# Observational Memory — injects extra system messages. Many local GGUF
# templates error with "System message must be at the beginning."
# Default: enabled only when MODEL_PROVIDER=dashscope. Force with true/false.
# ENABLE_OBSERVATIONAL_MEMORY=false

# --- Local: Ollama (http://127.0.0.1:11434) ---
# Start server: ollama serve
# Pull a tool-capable model, e.g.:
#   ollama pull qwen3-next:80b-a3b-thinking-q8_0
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_MODEL_ID=qwen3-next:80b-a3b-thinking-q8_0
# OLLAMA_API_KEY=ollama

# --- Local: LM Studio (http://127.0.0.1:1234) ---
# Enable "Local Server" in LM Studio, load a model, then set:
# MODEL_PROVIDER=lmstudio
LMSTUDIO_API_KEY=
LMSTUDIO_BASE_URL=http://127.0.0.1:1234/v1
# Must match a model id from LM Studio /v1/models
LMSTUDIO_MODEL_ID=qwen/qwen3-next-80b

# --- Cloud: Alibaba DashScope ---
# MODEL_PROVIDER=dashscope
DASHSCOPE_API_KEY=
# Intl endpoint (default). For China, use:
# DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
# Which model alias to use: qwen | glm | kimi
BROWSER_MODEL=qwen
# Optional: pin an exact DashScope model id (overrides BROWSER_MODEL mapping)
# DASHSCOPE_MODEL_ID=qwen3.8-max

# false = visible Chromium (default). Needed for interactive Gmail/2FA login.
BROWSER_HEADLESS=false

# Persistent Chromium profile for cookies/logins (default: ~/.mastra-browser/profiles/gmail).
# Use a dedicated automation profile — do not point this at your daily Chrome "User Data".
# BROWSER_PROFILE=~/.mastra-browser/profiles/gmail

# Optional: launch system Chrome instead of Playwright Chromium (often better for Google login).
# BROWSER_EXECUTABLE_PATH=/usr/bin/google-chrome

# Optional: connect to a remote Chrome via CDP instead of launching locally
# BROWSER_CDP_URL=http://127.0.0.1:9222
